rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /usersProfiles/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid;
      // update is open to any signed-in user because follow/unfollow edits the other profile
      allow update: if signedIn();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();   // tighten later: resource.data.uid == request.auth.uid

      match /comments/{commentId} {
        allow read, create, delete: if signedIn();
      }
    }

    match /privateChats/{chatId} {
      allow read, update: if signedIn() && resource.data.users[request.auth.uid] == true;
      allow create: if signedIn() && request.resource.data.users[request.auth.uid] == true;

      match /messages/{msgId} {
        allow read, create: if signedIn()
          && get(/databases/$(database)/documents/privateChats/$(chatId)).data.users[request.auth.uid] == true;
      }
    }
  }
}
